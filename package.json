{
  "name": "student-information-system",
  "version": "1.0.0",
  "description": "Sistem Informasi Siswa",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "prepare": "husky",
    "lint": "eslint src/controllers/*.js src/routes/*.js --fix",
    "format": "prettier --write \"public/pages/*.html\" \"public/css/*.css\" \"src/**/*.js\"",
    "format:check": "prettier --check \"public/pages/*.html\" \"public/css/*.css\" \"src/**/*.js\""
  },
  "dependencies": {
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-mysql-session": "^3.0.3",
    "express-session": "^1.17.3",
    "mysql2": "^3.6.5"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "husky": "^9.0.10",
    "lint-staged": "^15.2.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.2.4"
  }
}
